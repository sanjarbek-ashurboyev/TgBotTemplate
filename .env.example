# Copy to .env and fill in. .env is gitignored; never commit real values.

# From @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Async driver DSN. For docker compose, use the service name as the host:
#   postgresql+asyncpg://bot:bot@postgres:5432/bot
DB_DSN=postgresql+asyncpg://bot:bot@localhost:5432/bot
DB_ECHO=false

# Leave empty to use in-memory FSM storage (state lost on restart).
# For docker compose: redis://redis:6379/0
REDIS_DSN=redis://localhost:6379/0

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Discard updates that queued up while the bot was down
DROP_PENDING_UPDATES=true
